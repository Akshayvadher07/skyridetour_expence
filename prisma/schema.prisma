generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MovementType {
  INBOUND
  OUTBOUND
}

enum Role {
  ADMIN
  CLIENT
  OWNER
}

enum BookingStatus {
  PENDING
  APPROVED
  ONGOING
  REJECTED
  COMPLETED
}

enum BookingType {
  ONLINE
  MANUAL
  PLATFORM
}

model User {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  email       String        @unique
  password    String
  role        Role          @default(CLIENT)
  approved    Boolean       @default(false)
  notifications Notification[]
  prompts     Prompt[]

  warehouses  Warehouse[]   @relation("WarehouseOwner")

  bookings    Booking[]     @relation("ClientBookings")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Prompt {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  category     String
  tone         String
  style        String
  audience     String
  goal         String
  keywords     String[]
  length       String
  language     String
  instructions String?
  finalPrompt  String
  isFavorite   Boolean   @default(false)

  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum WarehouseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Warehouse {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  description        String?
  address            String
  area               Float             @default(0)
  totalCapacity      Float
  availableCapacity  Float
  pricing            Float
  storageType        String
  availableFrom      DateTime?
  materialsAllowed   String
  wdraStatus         Boolean           @default(false)
  gstNumber          String?
  images             String?
  features           String?

  status             WarehouseStatus  @default(PENDING)

  ownerId            String           @db.ObjectId
  owner              User             @relation("WarehouseOwner", fields: [ownerId], references: [id])

  bookings           Booking[]
  stockMovements     StockMovement[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Booking {
  id                        String          @id @default(auto()) @map("_id") @db.ObjectId

  warehouseId               String          @db.ObjectId
  warehouse                 Warehouse       @relation(fields: [warehouseId], references: [id])

  clientId                  String?         @db.ObjectId
  client                    User?           @relation("ClientBookings", fields: [clientId], references: [id])

  manualClientName          String?
  manualClientContact       String?

  weight                    Float
  commodityType             String

  bookingType               BookingType     @default(ONLINE)

  startDate                 DateTime
  endDate                   DateTime

  status                    BookingStatus   @default(PENDING)

  completionAcknowledged    Boolean         @default(false)

  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Notification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId

  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])

  title       String
  message     String

  isRead      Boolean   @default(false)

  createdAt   DateTime  @default(now())
}

model StockMovement {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId

  warehouseId    String         @db.ObjectId
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

  type           MovementType

  commodity      String
  weight         Float

  truckNumber    String?
  driverName     String?
  biltyNumber    String?
  partyName      String?

  status         String         @default("COMPLETED")

  notes          String?

  createdAt      DateTime       @default(now())
}